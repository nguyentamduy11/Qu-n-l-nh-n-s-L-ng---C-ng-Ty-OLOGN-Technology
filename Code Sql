BEGIN
    CREATE TABLE dbo.HopDong (
        MaHD VARCHAR(12) NOT NULL PRIMARY KEY,
        MaNV VARCHAR(10) NOT NULL,
        LoaiHopDong NVARCHAR(40) NOT NULL,
