-- IV. FUNCTION
-- 1. Lay so ngay cong theo nhan vien/thang/nam
CREATE OR ALTER FUNCTION dbo.fn_TongNgayCong
(
    @MaNV VARCHAR(10), @Thang TINYINT, @Nam SMALLINT
)
RETURNS INT
AS
BEGIN
    DECLARE @KetQua INT;
    SELECT @KetQua = SoNgayCong
    FROM dbo.ChamCong
    WHERE MaNV = @MaNV AND Thang = @Thang AND Nam = @Nam;
    RETURN ISNULL(@KetQua, 0);
END;
GO;

-- 2. Cong thuc luong minh hoa: (luong co ban * ngay cong / 26) + phu cap + thuong - khau tru
CREATE OR ALTER FUNCTION dbo.fn_TinhLuongThucNhan
(
    @LuongCoBan DECIMAL(18,2),
    @SoNgayCong INT,
    @TongPhuCap DECIMAL(18,2),
    @TongThuong DECIMAL(18,2),
    @TongKhauTru DECIMAL(18,2)
)
RETURNS DECIMAL(18,2)
AS
BEGIN
    RETURN CAST(ROUND(
        (@LuongCoBan * @SoNgayCong / 26.0)
        + @TongPhuCap + @TongThuong - @TongKhauTru, 2
    ) AS DECIMAL(18,2));
END;
GO

-- V. VIEW
CREATE OR ALTER VIEW dbo.vw_DanhSachNhanVien
AS
SELECT nv.MaNV, nv.HoTen, nv.NgaySinh, nv.GioiTinh,
       nv.SoDienThoai, nv.Email, nv.NgayVaoLam,
       pb.MaPB, pb.TenPB, cv.MaCV, cv.TenCV, nv.TrangThai
FROM dbo.NhanVien AS nv
JOIN dbo.PhongBan AS pb ON nv.MaPB = pb.MaPB
JOIN dbo.ChucVu AS cv ON nv.MaCV = cv.MaCV;
GO

CREATE OR ALTER VIEW dbo.vw_HopDongNhanVien
AS
SELECT hd.MaHD, nv.MaNV, nv.HoTen, pb.TenPB,
       hd.LoaiHopDong, hd.NgayBatDau, hd.NgayKetThuc,
       hd.LuongCoBan, hd.TrangThai
FROM dbo.HopDong AS hd
JOIN dbo.NhanVien AS nv ON hd.MaNV = nv.MaNV
JOIN dbo.PhongBan AS pb ON nv.MaPB = pb.MaPB;
GO

CREATE OR ALTER VIEW dbo.vw_ChiTietBangLuong
AS
SELECT bl.MaBangLuong, bl.MaNV, nv.HoTen, pb.TenPB,
       bl.Thang, bl.Nam, bl.SoNgayCong,
       bl.LuongCoBan, bl.TienLuongNgayCong,
       bl.TongPhuCap, bl.TongThuong, bl.TongKhauTru,
       bl.LuongThucNhan, bl.TrangThai, bl.NgayTinh
FROM dbo.BangLuong AS bl
JOIN dbo.NhanVien AS nv ON bl.MaNV = nv.MaNV
JOIN dbo.PhongBan AS pb ON nv.MaPB = pb.MaPB;
GO

CREATE OR ALTER VIEW dbo.vw_TongLuongPhongBan
AS
SELECT bl.Thang, bl.Nam, pb.MaPB, pb.TenPB,
       COUNT(*) AS SoNhanVienCoLuong,
       SUM(bl.LuongThucNhan) AS TongLuongThucNhan
FROM dbo.BangLuong AS bl
JOIN dbo.NhanVien AS nv ON bl.MaNV = nv.MaNV
JOIN dbo.PhongBan AS pb ON nv.MaPB = pb.MaPB
GROUP BY bl.Thang, bl.Nam, pb.MaPB, pb.TenPB;
GO

-- VI. STORED PROCEDURE
-- 1. Them nhan vien
CREATE OR ALTER PROCEDURE dbo.sp_ThemNhanVien
    @MaNV VARCHAR(10),
    @HoTen NVARCHAR(100),
    @NgaySinh DATE,
    @GioiTinh NVARCHAR(5),
    @NgayVaoLam DATE,
    @MaPB VARCHAR(10),
    @MaCV VARCHAR(10),
    @SoDienThoai VARCHAR(15) = NULL,
    @Email VARCHAR(120) = NULL,
    @DiaChi NVARCHAR(255) = NULL
AS
BEGIN
    SET NOCOUNT ON;
    IF EXISTS (SELECT 1 FROM dbo.NhanVien WHERE MaNV = @MaNV)
        THROW 50003, N'Mã nhân viên đã tồn tại.', 1;
    IF NOT EXISTS (SELECT 1 FROM dbo.PhongBan WHERE MaPB = @MaPB)
        THROW 50004, N'Mã phòng ban không tồn tại.', 1;
    IF NOT EXISTS (SELECT 1 FROM dbo.ChucVu WHERE MaCV = @MaCV)
        THROW 50005, N'Mã chức vụ không tồn tại.', 1;
    INSERT INTO dbo.NhanVien
        (MaNV, HoTen, NgaySinh, GioiTinh, SoDienThoai, Email,
         DiaChi, NgayVaoLam, MaPB, MaCV)
    VALUES
        (@MaNV, @HoTen, @NgaySinh, @GioiTinh, @SoDienThoai, @Email,
         @DiaChi, @NgayVaoLam, @MaPB, @MaCV);
    SELECT * FROM dbo.NhanVien WHERE MaNV = @MaNV;
END;
GO

-- 2. Cap nhat luong co ban tren hop dong
CREATE OR ALTER PROCEDURE dbo.sp_CapNhatLuongHopDong
    @MaHD VARCHAR(12),
    @LuongMoi DECIMAL(18,2)
AS
BEGIN
    SET NOCOUNT ON;
    IF NOT EXISTS (SELECT 1 FROM dbo.HopDong WHERE MaHD = @MaHD)
        THROW 50006, N'Hợp đồng không tồn tại.', 1;
    IF @LuongMoi IS NULL OR @LuongMoi <= 0
        THROW 50007, N'Lương mới phải lớn hơn 0.', 1;
    IF EXISTS (SELECT 1 FROM dbo.HopDong WHERE MaHD = @MaHD AND TrangThai = N'Đã hủy')
        THROW 50008, N'Không thể sửa hợp đồng đã hủy.', 1;
    UPDATE dbo.HopDong
    SET LuongCoBan = @LuongMoi
    WHERE MaHD = @MaHD;
    SELECT * FROM dbo.HopDong WHERE MaHD = @MaHD;
END;
GO

-- 3. Them hoac cap nhat cham cong cho mot thang
CREATE OR ALTER PROCEDURE dbo.sp_GhiNhanChamCong
    @MaNV VARCHAR(10),
    @Thang TINYINT,
    @Nam SMALLINT,
    @SoNgayCong INT,
    @SoNgayNghiPhep INT = 0,
    @GhiChu NVARCHAR(200) = NULL
AS
BEGIN
    SET NOCOUNT ON;
    IF NOT EXISTS (SELECT 1 FROM dbo.NhanVien WHERE MaNV = @MaNV)
        THROW 50009, N'Nhân viên không tồn tại.', 1;
    IF @Thang IS NULL OR @Thang NOT BETWEEN 1 AND 12
       OR @Nam IS NULL OR @Nam NOT BETWEEN 2000 AND 2100
       OR @SoNgayCong IS NULL OR @SoNgayCong NOT BETWEEN 0 AND 26
       OR @SoNgayNghiPhep IS NULL OR @SoNgayNghiPhep NOT BETWEEN 0 AND 31
        THROW 50010, N'Dữ liệu chấm công không hợp lệ.', 1;
    UPDATE dbo.ChamCong
       SET SoNgayCong = @SoNgayCong,
           SoNgayNghiPhep = @SoNgayNghiPhep,
           GhiChu = @GhiChu
     WHERE MaNV = @MaNV AND Thang = @Thang AND Nam = @Nam;
    IF @@ROWCOUNT = 0
    BEGIN
        INSERT INTO dbo.ChamCong (MaNV, Thang, Nam, SoNgayCong, SoNgayNghiPhep, GhiChu)
        VALUES (@MaNV, @Thang, @Nam, @SoNgayCong, @SoNgayNghiPhep, @GhiChu);
    END;
    SELECT * FROM dbo.ChamCong
    WHERE MaNV = @MaNV AND Thang = @Thang AND Nam = @Nam;
END;
GO

-- 4. Tinh luong cho tat ca nhan vien da cham cong trong thang
CREATE OR ALTER PROCEDURE dbo.sp_TinhLuongThang
    @Thang TINYINT,
    @Nam SMALLINT
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;

    IF @Thang IS NULL OR @Thang NOT BETWEEN 1 AND 12
       OR @Nam IS NULL OR @Nam NOT BETWEEN 2000 AND 2100
        THROW 50011, N'Tháng hoặc năm không hợp lệ.', 1;

    DECLARE @DauThang DATE = DATEFROMPARTS(@Nam, @Thang, 1);
    DECLARE @CuoiThang DATE = EOMONTH(@DauThang);

    IF NOT EXISTS (SELECT 1 FROM dbo.ChamCong WHERE Thang = @Thang AND Nam = @Nam)
        THROW 50012, N'Chưa có dữ liệu chấm công trong kỳ.', 1;

    IF EXISTS (
        SELECT 1 FROM dbo.ChamCong AS cc
        WHERE cc.Thang = @Thang AND cc.Nam = @Nam
          AND NOT EXISTS (
              SELECT 1 FROM dbo.HopDong AS hd
              WHERE hd.MaNV = cc.MaNV AND hd.TrangThai <> N'Đã hủy'
                AND hd.NgayBatDau <= @CuoiThang
                AND (hd.NgayKetThuc IS NULL OR hd.NgayKetThuc >= @DauThang)
          )
    )
        THROW 50013, N'Có nhân viên chấm công nhưng thiếu hợp đồng phù hợp kỳ lương.', 1;

    BEGIN TRY
        BEGIN TRANSACTION;

        SELECT cc.MaNV, cc.SoNgayCong, hd.LuongCoBan,
               CAST(ROUND(hd.LuongCoBan * cc.SoNgayCong / 26.0, 2) AS DECIMAL(18,2)) AS TienLuongNgayCong,
               CAST(ISNULL(pc.TongPhuCap, 0) AS DECIMAL(18,2)) AS TongPhuCap,
               CAST(ISNULL(tk.TongThuong, 0) AS DECIMAL(18,2)) AS TongThuong,
               CAST(ISNULL(tk.TongKhauTru, 0) AS DECIMAL(18,2)) AS TongKhauTru,
               dbo.fn_TinhLuongThucNhan(
                   hd.LuongCoBan, cc.SoNgayCong,
                   ISNULL(pc.TongPhuCap, 0),
                   ISNULL(tk.TongThuong, 0),
                   ISNULL(tk.TongKhauTru, 0)
               ) AS LuongThucNhan
        INTO #LuongTam
        FROM dbo.ChamCong AS cc
        CROSS APPLY (
            SELECT TOP (1) h.LuongCoBan
            FROM dbo.HopDong AS h
            WHERE h.MaNV = cc.MaNV AND h.TrangThai <> N'Đã hủy'
              AND h.NgayBatDau <= @CuoiThang
              AND (h.NgayKetThuc IS NULL OR h.NgayKetThuc >= @DauThang)
            ORDER BY h.NgayBatDau DESC, h.MaHD DESC
        ) AS hd
        OUTER APPLY (
            SELECT SUM(p.SoTien) AS TongPhuCap
            FROM dbo.ChiTietPhuCap AS p
            WHERE p.MaNV = cc.MaNV AND p.Thang = @Thang AND p.Nam = @Nam
        ) AS pc
        OUTER APPLY (
            SELECT SUM(CASE WHEN t.Loai = N'Thưởng' THEN t.SoTien ELSE 0 END) AS TongThuong,
                   SUM(CASE WHEN t.Loai = N'Khấu trừ' THEN t.SoTien ELSE 0 END) AS TongKhauTru
            FROM dbo.ThuongKhauTru AS t
            WHERE t.MaNV = cc.MaNV AND t.Thang = @Thang AND t.Nam = @Nam
        ) AS tk
        WHERE cc.Thang = @Thang AND cc.Nam = @Nam;

        IF EXISTS (SELECT 1 FROM #LuongTam WHERE LuongThucNhan < 0)
            THROW 50014, N'Có bảng lương âm: hãy kiểm tra các khoản khấu trừ.', 1;

        IF EXISTS (
            SELECT 1 FROM dbo.BangLuong AS bl
            JOIN #LuongTam AS t ON t.MaNV = bl.MaNV
            WHERE bl.Thang = @Thang AND bl.Nam = @Nam
              AND bl.TrangThai = N'Đã chốt'
        )
            THROW 50015, N'Kỳ lương có nhân viên đã chốt: không được tính đè.', 1;

        UPDATE bl
           SET bl.SoNgayCong = t.SoNgayCong,
               bl.LuongCoBan = t.LuongCoBan,
               bl.TienLuongNgayCong = t.TienLuongNgayCong,
               bl.TongPhuCap = t.TongPhuCap,
               bl.TongThuong = t.TongThuong,
               bl.TongKhauTru = t.TongKhauTru,
               bl.LuongThucNhan = t.LuongThucNhan,
               bl.NgayTinh = SYSDATETIME()
        FROM dbo.BangLuong AS bl
        JOIN #LuongTam AS t ON t.MaNV = bl.MaNV
        WHERE bl.Thang = @Thang AND bl.Nam = @Nam;

        INSERT INTO dbo.BangLuong
            (MaNV, Thang, Nam, SoNgayCong, LuongCoBan, TienLuongNgayCong,
             TongPhuCap, TongThuong, TongKhauTru, LuongThucNhan)
        SELECT t.MaNV, @Thang, @Nam, t.SoNgayCong, t.LuongCoBan,
               t.TienLuongNgayCong, t.TongPhuCap, t.TongThuong,
               t.TongKhauTru, t.LuongThucNhan
        FROM #LuongTam AS t
        WHERE NOT EXISTS (
            SELECT 1 FROM dbo.BangLuong AS bl
            WHERE bl.MaNV = t.MaNV AND bl.Thang = @Thang AND bl.Nam = @Nam
        );

        COMMIT TRANSACTION;
    END TRY
    BEGIN CATCH
        IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;
        THROW;
    END CATCH;

    SELECT * FROM dbo.vw_ChiTietBangLuong
    WHERE Thang = @Thang AND Nam = @Nam
    ORDER BY MaNV;
END;
GO

-- 5. Tra cuu bang luong theo ky / theo nhan vien
CREATE OR ALTER PROCEDURE dbo.sp_TraCuuBangLuong
    @Thang TINYINT = NULL,
    @Nam SMALLINT = NULL,
    @MaNV VARCHAR(10) = NULL
AS
BEGIN
    SET NOCOUNT ON;
    SELECT *
    FROM dbo.vw_ChiTietBangLuong
    WHERE (@Thang IS NULL OR Thang = @Thang)
      AND (@Nam IS NULL OR Nam = @Nam)
      AND (@MaNV IS NULL OR MaNV = @MaNV)
    ORDER BY Nam DESC, Thang DESC, MaNV;
END;
GO

-- VII. DU LIEU MAU (chi chen neu chua ton tai)
INSERT INTO dbo.PhongBan (MaPB, TenPB, MoTa)
SELECT v.MaPB, v.TenPB, v.MoTa
FROM (VALUES
    ('PB01', N'Phòng Công nghệ thông tin', N'Phát triển và kiểm thử phần mềm'),
    ('PB02', N'Phòng Nhân sự', N'Quản lý hồ sơ và nhân sự'),
    ('PB03', N'Phòng Kế toán', N'Tài chính và tiền lương')
) AS v(MaPB, TenPB, MoTa)
WHERE NOT EXISTS (SELECT 1 FROM dbo.PhongBan WHERE MaPB = v.MaPB);

