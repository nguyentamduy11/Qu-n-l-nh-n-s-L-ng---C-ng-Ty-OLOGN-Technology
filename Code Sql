-- III. TRIGGER
-- 1. Khong cho hop dong cua cung nhan vien trung thoi gian (tru hop dong da huy)
CREATE OR ALTER TRIGGER dbo.trg_HopDong_KhongTrungThoiGian
ON dbo.HopDong
AFTER INSERT, UPDATE
AS
BEGIN
    SET NOCOUNT ON;
    IF EXISTS (
        SELECT 1
        FROM inserted AS i
        INNER JOIN dbo.HopDong AS h
            ON h.MaNV = i.MaNV AND h.MaHD <> i.MaHD
        WHERE i.TrangThai <> N'Đã hủy'
          AND h.TrangThai <> N'Đã hủy'
          AND i.NgayBatDau <= ISNULL(h.NgayKetThuc, CONVERT(DATE, '99991231'))
          AND h.NgayBatDau <= ISNULL(i.NgayKetThuc, CONVERT(DATE, '99991231'))
    )
    BEGIN
       ; THROW 50001, N'Nhân viên đã có hợp đồng khác trùng khoảng thời gian.', 1;
    END;
END;
GO

