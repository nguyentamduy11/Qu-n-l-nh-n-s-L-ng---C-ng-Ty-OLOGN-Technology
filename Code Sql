        MaCV VARCHAR(10) NOT NULL,
        TrangThai NVARCHAR(20) NOT NULL
            CONSTRAINT DF_NhanVien_TrangThai DEFAULT N'Đang làm',
        CONSTRAINT CK_NhanVien_TrangThai CHECK (TrangThai IN (N'Đang làm', N'Tạm nghỉ', N'Nghỉ việc')),
        CONSTRAINT CK_NhanVien_NgayVaoLam CHECK (NgayVaoLam > NgaySinh),
        CONSTRAINT FK_NhanVien_PhongBan FOREIGN KEY (MaPB) REFERENCES dbo.PhongBan(MaPB),
        CONSTRAINT FK_NhanVien_ChucVu FOREIGN KEY (MaCV) REFERENCES dbo.ChucVu(MaCV)
    );
END;
GO

